# Enviroment
NODE_ENV=DEV

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=poposerver_dev_postgres

# SERVICE (REST + WebSocket 단일 포트)
API_PORT=9000

# Rate limit
RATE_LIMIT_ENABLED=true
# 스모크 테스트가 한 IP로 수백 건을 쏘므로 dev에서는 전역 상한을 사실상 무제한으로 둔다.
# 라우트별 리밋(로그인 10/5분, OAuth 20/15분)은 그대로라 레이트 리밋 검증은 유효하다.
RATE_LIMIT_GLOBAL_MAX=100000

# 동시 게임 접속 슬롯 최대치 (초과 시 큐 진입)
SLOT_CAPACITY=2

# Allow url
CORS_ORIGIN=http://localhost:3000

# OAuth — Google
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:9000/api/auth/oauth/google/callback

# OAuth — Discord
OAUTH_DISCORD_CLIENT_ID=your-discord-client-id
OAUTH_DISCORD_CLIENT_SECRET=your-discord-client-secret
OAUTH_DISCORD_REDIRECT_URI=http://localhost:9000/api/auth/oauth/discord/callback

# OAuth — full-page redirect 흐름. 콜백 후 클라이언트 앱 루트로 복귀한다.
# 실패 시 컨트롤러가 ?code={에러코드}를 append하므로 prefix 없이 둔다.
OAUTH_CLIENT_SUCCESS_URL=http://localhost:3000/?oauth=ok
OAUTH_CLIENT_FAILURE_URL=http://localhost:3000/
# DB 커넥션 풀 최대치 (postgres.js 기본값과 동일)
DB_POOL_MAX=10

# 내부 전용 라우트(/api/__internal) 인증 토큰
INTERNAL_TOKEN=dev-internal-token
