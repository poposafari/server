# Enviroment
NODE_ENV=DEV

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=poposerver_dev_postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# SERVICES
API_PORT=9000
SOCKET_PORT=9010

# Rate limit
RATE_LIMIT_ENABLED=false

# Allow url
CORS_ORIGIN=http://localhost:3000

# OAuth — Google
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:9000/api/auth/oauth/google/callback

# OAuth — Discord
OAUTH_DISCORD_CLIENT_ID=your-discord-client-id
OAUTH_DISCORD_CLIENT_SECRET=your-discord-client-secret
OAUTH_DISCORD_REDIRECT_URI=http://localhost:9000/api/auth/oauth/discord/callback

# OAuth — popup 흐름의 정적 콜백 페이지로 redirect.
# callback.html이 opener에 postMessage 후 self.close. opener가 없으면 루트로 fallback.
OAUTH_CLIENT_SUCCESS_URL=http://localhost:3000/oauth-callback.html?status=ok
OAUTH_CLIENT_FAILURE_URL=http://localhost:3000/oauth-callback.html