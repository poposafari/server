# Enviroment
NODE_ENV=DEV

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=poposerver_dev_postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# SERVICES
API_PORT=9000
SOCKET_PORT=9010

# Security
JWT_ACCESS_SECRET=poposerver_access_secret_key_1234
JWT_REFRESH_SECRET=poposerver_refresh_secret_key_1234

# Rate limit
RATE_LIMIT_ENABLED=false

# Allow url
CORS_ORIGIN=http://localhost:3000

# OAuth — Google
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:9000/api/auth/oauth/google/callback

# OAuth — Discord
OAUTH_DISCORD_CLIENT_ID=your-discord-client-id
OAUTH_DISCORD_CLIENT_SECRET=your-discord-client-secret
OAUTH_DISCORD_REDIRECT_URI=http://localhost:9000/api/auth/oauth/discord/callback

# OAuth — 콜백 후 클라이언트 루트로 복귀 (부팅 흐름이 sid 쿠키 보고 분기)
OAUTH_CLIENT_SUCCESS_URL=http://localhost:3000/
OAUTH_CLIENT_FAILURE_URL=http://localhost:3000/