# Enviroment
NODE_ENV=test

# Database
DB_HOST=localhost
DB_PORT=8888
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=poposerver_dev_postgres

# SERVICE (REST + WebSocket 단일 포트)
API_PORT=9000

# Rate limit
RATE_LIMIT_ENABLED=false

# 동시 게임 접속 슬롯 최대치
# 기본은 충분히 큰 값. 큐 분기 검증 테스트는 케이스 내부에서 envConfig.SLOT_CAPACITY를 override 한다.
SLOT_CAPACITY=200

# Allow url
CORS_ORIGIN=http://localhost:5173