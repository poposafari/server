# Environment
NODE_ENV=PROD

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=popo
DB_PASSWORD=CHANGE_ME
DB_DATABASE=poposafari

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Services
API_PORT=9000
SOCKET_PORT=9010

# CORS
CORS_ORIGIN=https://poposafari.net

# Rate limit
RATE_LIMIT_ENABLED=true

# OAuth — Google
OAUTH_GOOGLE_CLIENT_ID=CHANGE_ME
OAUTH_GOOGLE_CLIENT_SECRET=CHANGE_ME
OAUTH_GOOGLE_REDIRECT_URI=https://api.poposafari.net/api/auth/oauth/google/callback

# OAuth — Discord
OAUTH_DISCORD_CLIENT_ID=CHANGE_ME
OAUTH_DISCORD_CLIENT_SECRET=CHANGE_ME
OAUTH_DISCORD_REDIRECT_URI=https://api.poposafari.net/api/auth/oauth/discord/callback

# OAuth — 콜백 후 클라이언트 리다이렉트
OAUTH_CLIENT_SUCCESS_URL=https://poposafari.net
OAUTH_CLIENT_FAILURE_URL=https://poposafari.net
