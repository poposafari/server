# Environment
NODE_ENV=PROD

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=popo
DB_PASSWORD=CHANGE_ME
DB_DATABASE=poposafari

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Services
API_PORT=9000
SOCKET_PORT=9010

INTERNAL_TOKEN=poposafari

# CORS
CORS_ORIGIN=https://poposafari.net

# Rate limit
RATE_LIMIT_ENABLED=true

# 동시 게임 접속 슬롯 최대치 (1주차 실측 후 조정)
SLOT_CAPACITY=200

# OAuth — Google
OAUTH_GOOGLE_CLIENT_ID=CHANGE_ME
OAUTH_GOOGLE_CLIENT_SECRET=CHANGE_ME
OAUTH_GOOGLE_REDIRECT_URI=https://api.poposafari.net/api/auth/oauth/google/callback

# OAuth — Discord
OAUTH_DISCORD_CLIENT_ID=CHANGE_ME
OAUTH_DISCORD_CLIENT_SECRET=CHANGE_ME
OAUTH_DISCORD_REDIRECT_URI=https://api.poposafari.net/api/auth/oauth/discord/callback

# OAuth — full-page redirect 흐름. 콜백 후 클라이언트 앱 루트로 복귀한다.
# 실패 시 컨트롤러가 ?code={에러코드}를 append하므로 prefix 없이 둔다.
OAUTH_CLIENT_SUCCESS_URL=https://poposafari.net/?oauth=ok
OAUTH_CLIENT_FAILURE_URL=https://poposafari.net/
