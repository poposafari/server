# Environment
NODE_ENV=PROD

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=popo
DB_PASSWORD=CHANGE_ME
DB_DATABASE=poposafari

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Services
API_PORT=9000
SOCKET_PORT=9010

INTERNAL_TOKEN=poposafari

# CORS
CORS_ORIGIN=https://poposafari.net

# Rate limit
RATE_LIMIT_ENABLED=true

# OAuth — Google
OAUTH_GOOGLE_CLIENT_ID=CHANGE_ME
OAUTH_GOOGLE_CLIENT_SECRET=CHANGE_ME
OAUTH_GOOGLE_REDIRECT_URI=https://api.poposafari.net/api/auth/oauth/google/callback

# OAuth — Discord
OAUTH_DISCORD_CLIENT_ID=CHANGE_ME
OAUTH_DISCORD_CLIENT_SECRET=CHANGE_ME
OAUTH_DISCORD_REDIRECT_URI=https://api.poposafari.net/api/auth/oauth/discord/callback

# OAuth — popup 흐름의 정적 콜백 페이지로 redirect.
# callback.html이 opener에 postMessage 후 self.close. opener가 없으면 루트로 fallback.
OAUTH_CLIENT_SUCCESS_URL=https://poposafari.net/oauth-callback.html?status=ok
OAUTH_CLIENT_FAILURE_URL=https://poposafari.net/oauth-callback.html
