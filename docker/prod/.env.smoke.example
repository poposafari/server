# 로컬 스모크 부하용 환경값. 복사해서 .env.smoke로 사용:
#   cp docker/prod/.env.smoke.example docker/prod/.env.smoke
# .env.smoke는 gitignore (비밀 아님, 로컬 throwaway 값이지만 관례상 비커밋).
#
# 두 역할을 겸한다:
#  (1) compose-level (--env-file): postgres POSTGRES_*, redis --requirepass 등 ${...} 치환
#  (2) container env_file: api/socket/flush/worker 컨테이너 안 process.env
# DB_HOST/REDIS_HOST만 예외 — 컨테이너는 base compose의 environment(DB_HOST=postgres,
# REDIS_HOST=redis)가 env_file을 덮어쓴다. 그래서 아래 localhost 값은 **호스트측 drizzle push 전용**.

NODE_ENV=PROD

# DB — DB_HOST=localhost는 호스트에서 drizzle-kit push 할 때 쓰는 값.
#      컨테이너는 base compose가 DB_HOST=postgres로 덮어씀(양립).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=poposerver
DB_PASSWORD=smokepw
DB_DATABASE=poposerver_smoke

# Redis — REDIS_HOST=localhost도 호스트 기준. 컨테이너는 REDIS_HOST=redis로 덮어씀.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=smokeredis

API_PORT=9000
SOCKET_PORT=9010
INTERNAL_TOKEN=smoke-internal-token

CORS_ORIGIN=http://localhost:3000

# 부하 테스트 핵심 2개:
#  - 레이트리밋 OFF: login burst가 5/15min 룰에 막히지 않게
#  - SLOT_CAPACITY 크게: 슬롯 게이트가 OOM 천장보다 먼저 막지 않게(스모크는 100까지 ramp)
RATE_LIMIT_ENABLED=false
SLOT_CAPACITY=1000

# OAuth — env.ts 스키마가 required(.url())이라 더미 유효 URL로 채워야 부팅됨. 스모크에선 미사용.
OAUTH_GOOGLE_CLIENT_ID=dummy
OAUTH_GOOGLE_CLIENT_SECRET=dummy
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:9000/api/auth/oauth/google/callback
OAUTH_DISCORD_CLIENT_ID=dummy
OAUTH_DISCORD_CLIENT_SECRET=dummy
OAUTH_DISCORD_REDIRECT_URI=http://localhost:9000/api/auth/oauth/discord/callback
OAUTH_CLIENT_SUCCESS_URL=http://localhost:3000/oauth/success
OAUTH_CLIENT_FAILURE_URL=http://localhost:3000/oauth/failure
