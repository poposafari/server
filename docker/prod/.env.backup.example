# Cloudflare R2 endpoint — 0-5에서 기록한 Account ID 포함
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=poposafari-backups
R2_PROFILE=r2

# 백업 실패/누락 알림 채널 (Phase 0-4 #alerts Webhook)
DISCORD_WEBHOOK_ALERTS=https://discord.com/api/webhooks/xxxxxxxx

# check-health.sh dead-man's switch heartbeat (Healthchecks.io ping URL)
# 매 cron 완주 시 이 URL로 ping → 박스/cron 하드다운 시 ping 끊김을 외부가 감지.
# 미설정 시 heartbeat 생략(스크립트는 그대로 동작). URL이 곧 비밀이라 비커밋.
# HC_PING_URL=https://hc-ping.com/<your-uuid>

# (선택) 환경별 조정 — which docker / which aws 결과로 맞춤
# DOCKER_BIN=/usr/bin/docker
# AWS_BIN=/usr/bin/aws
# PG_CONTAINER=poposerver_postgres
# MIN_SIZE=100000     # 덤프 크기 하한(B). 게임 성장에 맞춰 상향
