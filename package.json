{
  "name": "poposerver",
  "version": "0.0.0",
  "private": true,
  "description": "poposafari api & database & socket & worker server",
  "scripts": {
    "dev": "concurrently -n \"API,SOCK,WORK\" -c \"blue,magenta,yellow\" \"pnpm --filter @popo/api dev\" \"pnpm --filter @popo/socket dev\" \"pnpm --filter @popo/worker dev\"",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "clean": "rimraf dist coverage node_modules apps/*/dist libs/*/dist",
    "prepare": "husky install",
    "db:dev": "docker compose -f docker/dev/docker-compose.yml --env-file .env.dev up -d",
    "db:prod": "docker compose -f docker/prod/docker-compose.yml --env-file .env up -d",
    "db:down": "docker compose -f docker/dev/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2",
    "csv-parse": "^6.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
