{
  "name": "poposerver",
  "version": "0.0.0",
  "private": true,
  "description": "poposafari api & database & socket & worker server",
  "scripts": {
    "dev": "pnpm test && pnpm start:dev",
    "start:dev": "concurrently -n \"API,SOCK,WORK\" -c \"blue,magenta,yellow\" \"pnpm --filter @poposerver/api dev\" \"pnpm --filter @poposerver/socket dev\" \"pnpm --filter @poposerver/worker dev\"",
    "test": "dotenv -e .env.test -- jest",
    "pretest": "pnpm db:test:up",
    "posttest": "pnpm db:test:down",
    "api:dev": "pnpm test && ts-node -r tsconfig-paths/register apps/api/main.ts",
    "db:dev": "docker compose -f docker/dev/docker-compose.yml --env-file .env.dev up -d",
    "db:prod": "docker compose -f docker/prod/docker-compose.yml --env-file .env up -d",
    "db:test:up": "docker compose -f docker/dev/docker-compose.yml --env-file .env.dev up -d postgres-test redis-test",
    "db:test:down": "docker compose -f docker/dev/docker-compose.yml stop postgres-test redis-test",
    "db:clean": "docker compose -f docker/dev/docker-compose.yml down -v",
    "build": "pnpm -r run build",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "clean": "rimraf dist coverage node_modules apps/*/dist libs/*/dist",
    "prepare": "husky install",
    "worker:dev": "ts-node -r tsconfig-paths/register apps/worker/main.ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2",
    "csv-parse": "^6.1.0",
    "zod": "^4.3.4",
    "typeorm": "^0.3.28",
    "reflect-metadata": "^0.2.2",
    "tsconfig-paths": "^4.2.0",
    "ioredis": "^5.8.2",
    "@types/ioredis": "^4.28.10",
    "uuid": "^9.0.1",
    "@types/uuid": "^9.0.7",
    "node-cron": "^3.0.3",
    "@types/node-cron": "^3.0.11",
    "@socket.io/redis-adapter": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "socket.io": "^4.8.3",
    "express": "^4.22.1",
    "@types/express": "^4.17.21",
    "cors": "^2.8.5",
    "@types/cors": "^2.8.19",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "@types/morgan": "^1.9.10",
    "bcrypt": "^6.0.0",
    "@types/bcrypt": "^6.0.0",
    "express-async-errors": "^3.1.1",
    "passport": "^0.7.0",
    "@types/passport": "^1.0.17",
    "cookie-parser": "^1.4.7",
    "@types/cookie-parser": "^1.4.10",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "ts-jest": "^29.4.6",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "express-rate-limit": "^8.2.1",
    "dotenv-cli": "^11.0.0",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "axios": "^1.13.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
