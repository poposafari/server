{
  "name": "poposerver",
  "version": "0.0.0",
  "private": true,
  "description": "poposafari api & database & socket & worker server",
  "scripts": {
    "test": "dotenv -e .env.test -- jest",
    "dev": "ts-node -r tsconfig-paths/register apps/server/main.ts",
    "server:dev": "ts-node -r tsconfig-paths/register apps/server/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias -p tsconfig.json && node -e \"require('fs').cpSync('lib/master', 'dist/lib/master', {recursive:true})\"",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "db:dev": "docker compose -f docker/dev/docker-compose.yml --env-file .env.dev up -d",
    "db:test:up": "docker compose -f docker/dev/docker-compose.yml --env-file .env.dev up -d postgres-test",
    "db:test:down": "docker compose -f docker/dev/docker-compose.yml stop postgres-test",
    "db:push:dev": "dotenv -e .env.dev -- drizzle-kit push",
    "db:push:prod": "dotenv -e docker/prod/.env.prod -- drizzle-kit push",
    "db:generate": "dotenv -e docker/prod/.env.prod -- drizzle-kit generate",
    "db:migrate:dev": "dotenv -e .env.dev -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e docker/prod/.env.prod -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.dev -- drizzle-kit studio",
    "clean": "rimraf dist coverage node_modules",
    "prepare": "husky install"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.17",
    "@types/uuid": "^9.0.7",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.2.1",
    "fastify": "^5.8.4",
    "fastify-plugin": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "postgres": "^3.4.8",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "artillery": "^2.0.30",
    "axios": "^1.13.4",
    "concurrently": "^8.2.2",
    "csv-parse": "^6.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "seedrandom": "^3.0.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.8.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
